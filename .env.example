# Copy to .env and fill in real values. NEVER commit .env.
# Example for local development with PostgreSQL running locally:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/passwordless_demo

# PostgreSQL connection string used by Prisma and the backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/passwordless_demo

# Express port (frontend calls this via NEXT_PUBLIC_API_URL).
PORT=4000

# Secret used to sign JWT session cookies and recovery tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# JWT session lifetime (e.g. 1h, 15m).
JWT_EXPIRES_IN=1h

# WebAuthn relying-party config. For local dev over localhost use these exact values:
# RP ID must be the hostname (no port); ORIGIN must match the frontend URL exactly.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Passwordless Demo (CNS)
WEBAUTHN_ORIGIN=http://localhost:3000

# Frontend URL allowed by CORS (must match where Next.js runs).
WEB_ORIGIN=http://localhost:3000
